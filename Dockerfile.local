# syntax=docker/dockerfile:1.7

FROM node:24-trixie-slim AS frontend
WORKDIR /src/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM golang:1.26-trixie AS backend
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=frontend /src/internal/webui/static ./internal/webui/static
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/xianyu-server ./cmd/server

FROM node:24-trixie-slim
ENV TZ=Asia/Shanghai
WORKDIR /app
COPY --from=backend /out/xianyu-server /app/xianyu-server
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates; \
    rm -rf /var/lib/apt/lists/*; \
    mkdir -p /app/data /app/browser_data
EXPOSE 59188
CMD ["/app/xianyu-server", "-addr", ":59188", "-no-browser"]
